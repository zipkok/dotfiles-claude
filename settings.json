{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y ccstatusline@latest --hook"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pre-commit-lint.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/protect-main-branch.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/require-tests.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/allow-curl-get.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/protect-sensitive-files.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-build-artifacts.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/woobs/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-claude-md-update.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/woobs/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y ccstatusline@latest --hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/woobs/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/woobs/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/woobs/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/woobs/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/woobs/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/woobs/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/woobs/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/woobs/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/woobs/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat)\nprintf '%s' \"$input\" | npx -y @owloops/claude-powerline@latest\ntp=$(printf '%s' \"$input\" | jq -r '.transcript_path // empty' 2>/dev/null)\nif [ -n \"$tp\" ] && [ -f \"$tp\" ]; then\n  skill=$(tail -n 400 \"$tp\" 2>/dev/null | jq -rs 'map(select(.type==\"assistant\")) | last | .attributionSkill // empty' 2>/dev/null)\n  [ -n \"$skill\" ] && [ \"$skill\" != \"null\" ] && printf '\\nSkill: %s\\n' \"$skill\"\nfi"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "jq -r 'first(.agent.name, .agent_name, .name, .session.name) // \"subagent\"' 2>/dev/null || echo subagent"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "spex@cc-rhuss-marketplace": true,
    "claude-md-management@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "last30days@last30days-skill": true,
    "claude-powerline@claude-powerline": true,
    "slidev@cc-rhuss-marketplace": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "cc-rhuss-marketplace": {
      "source": {
        "source": "github",
        "repo": "rhuss/cc-rhuss-marketplace"
      },
      "autoUpdate": true
    },
    "last30days-skill": {
      "source": {
        "source": "github",
        "repo": "mvanhorn/last30days-skill"
      },
      "autoUpdate": true
    },
    "claude-powerline": {
      "source": {
        "source": "github",
        "repo": "Owloops/claude-powerline"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "high",
  "advisorModel": "opus",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "mcpServers": {
    "kubernetes": {
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "-y",
        "kubernetes-mcp-server@latest"
      ]
    }
  }
}
